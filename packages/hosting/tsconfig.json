{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    // Source modules import each other with explicit `.ts` extensions so the
    // Supabase edge functions (Deno) can import this package's source directly
    // and stay byte-identical with what the daemon runs. `rewrite…` turns those
    // back into `.js` in the emitted declarations so Node consumers resolve
    // against `dist/`.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
