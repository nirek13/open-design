{
  "name": "@open-design/hosting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript core for Open Design one-click hosting: manifests, slugs, and request-path resolution shared by the daemon publisher and the Supabase edge runtime.",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "node ./esbuild.config.mjs && tsc -p tsconfig.json --emitDeclarationOnly && node --experimental-strip-types ./scripts/rewrite-dts-extensions.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.28.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
